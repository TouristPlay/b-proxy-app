{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Права главного окна на компьютере: автозапуск, размер окна, обновление приложения",
  "platforms": [
    "linux",
    "windows",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "autostart:default",
    "window-state:default",
    "updater:default",
    "process:allow-restart"
  ]
}
